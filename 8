
import java.util.*;

public class Main {

    static int n, W;
    static int[] w, p;
    static int maxProfit = 0;

    // Dynamic Programming
    static void knapsackDP() {

        int[][] dp = new int[n + 1][W + 1];

        for (int i = 1; i <= n; i++) {
            for (int j = 0; j <= W; j++) {

                if (w[i - 1] <= j) {
                    dp[i][j] = Math.max(
                        p[i - 1] + dp[i - 1][j - w[i - 1]],
                        dp[i - 1][j]
                    );
                } else {
                    dp[i][j] = dp[i - 1][j];
                }
            }
        }

        System.out.println("Maximum Profit = " + dp[n][W]);
    }

    // Branch and Bound
    static class Node {
        int level, weight, profit;
        double bound;

        Node(int level, int weight, int profit) {
            this.level = level;
            this.weight = weight;
            this.profit = profit;
            this.bound = calculateBound(this);
        }
    }

    static double calculateBound(Node u) {

        if (u.weight > W)
            return 0;

        double profitBound = u.profit;
        int j = u.level + 1;
        int totalWeight = u.weight;

        while (j < n && totalWeight + w[j] <= W) {
            totalWeight += w[j];
            profitBound += p[j];
            j++;
        }

        if (j < n) {
            profitBound += (W - totalWeight) *
                           (double) p[j] / w[j];
        }

        return profitBound;
    }

    static int knapsackBB() {

        maxProfit = 0;

        PriorityQueue<Node> pq = new PriorityQueue<>(
            (a, b) -> Double.compare(b.bound, a.bound)
        );

        pq.add(new Node(-1, 0, 0));

        while (!pq.isEmpty()) {

            Node u = pq.poll();

            if (u.bound <= maxProfit)
                continue;

            int next = u.level + 1;

            if (next >= n)
                continue;

            int newWeight = u.weight + w[next];
            int newProfit = u.profit + p[next];

            // Include item
            if (newWeight <= W) {

                maxProfit = Math.max(maxProfit, newProfit);

                Node include = new Node(
                    next, newWeight, newProfit
                );

                if (include.bound > maxProfit)
                    pq.add(include);
            }

            // Exclude item
            Node exclude = new Node(
                next, u.weight, u.profit
            );

            if (exclude.bound > maxProfit)
                pq.add(exclude);
        }

        return maxProfit;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Select method first
        System.out.println("Select Knapsack Method:");
        System.out.println("1. Dynamic Programming");
        System.out.println("2. Branch and Bound");

        System.out.print("Enter your choice: ");
        int choice = sc.nextInt();

        switch (choice) {

            case 1:
            case 2:

                // Take input after method selection
                System.out.print("Enter number of items: ");
                n = sc.nextInt();

                w = new int[n];
                p = new int[n];

                System.out.print("Enter knapsack capacity: ");
                W = sc.nextInt();

                for (int i = 0; i < n; i++) {

                    System.out.print("Enter weight of item " + (i + 1) + ": ");
                    w[i] = sc.nextInt();

                    System.out.print("Enter profit of item " + (i + 1) + ": ");
                    p[i] = sc.nextInt();
                }

                if (choice == 1) {

                    System.out.println("\nDynamic Programming:");
                    knapsackDP();

                } else {

                    // Sort by profit/weight ratio
                    for (int i = 0; i < n - 1; i++) {
                        for (int j = i + 1; j < n; j++) {

                            double r1 = (double) p[i] / w[i];
                            double r2 = (double) p[j] / w[j];

                            if (r1 < r2) {

                                int temp = p[i];
                                p[i] = p[j];
                                p[j] = temp;

                                temp = w[i];
                                w[i] = w[j];
                                w[j] = temp;
                            }
                        }
                    }

                    System.out.println("\nBranch and Bound:");
                    System.out.println("Maximum Profit = " + knapsackBB());
                }
                break;

            default:
                System.out.println("Invalid Choice!");
        }

        sc.close();
    }
}



