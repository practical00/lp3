
import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of items: ");
        int n = sc.nextInt();

        int[] profit = new int[n];
        int[] weight = new int[n];
        double[] ratio = new double[n];

        System.out.print("Enter knapsack capacity: ");
        int capacity = sc.nextInt();

        for (int i = 0; i < n; i++) {

            System.out.print("Enter profit " + (i + 1) + ": ");
            profit[i] = sc.nextInt();

            System.out.print("Enter weight " + (i + 1) + ": ");
            weight[i] = sc.nextInt();

            ratio[i] = (double) profit[i] / weight[i];
        }

        // Sorting by profit/weight ratio
        for (int i = 0; i < n - 1; i++) {

            for (int j = i + 1; j < n; j++) {

                if (ratio[i] < ratio[j]) {

                    double temp = ratio[i];
                    ratio[i] = ratio[j];
                    ratio[j] = temp;

                    int t = profit[i];
                    profit[i] = profit[j];
                    profit[j] = t;

                    t = weight[i];
                    weight[i] = weight[j];
                    weight[j] = t;
                }
            }
        }

        double totalProfit = 0;

        System.out.println("\nItems after sorting:");

        for (int i = 0; i < n; i++) {
            System.out.println("Item " + (i + 1)
                    + " Profit = " + profit[i]
                    + ", Weight = " + weight[i]
                    + ", Ratio = " + ratio[i]);
        }

        System.out.println("\nStepwise Selection:");

        for (int i = 0; i < n; i++) {

            if (capacity == 0)
                break;

            if (weight[i] <= capacity) {

                totalProfit += profit[i];
                capacity -= weight[i];

                System.out.println("\nStep " + (i + 1));
                System.out.println("Selected Item: " + (i + 1));
                System.out.println("Weight Taken: " + weight[i]);
                System.out.println("Profit Added: " + profit[i]);
                System.out.println("Remaining Capacity: " + capacity);
                System.out.println("Total Profit: " + totalProfit);

            } else {

                double fraction = (double) capacity / weight[i];
                double addedProfit = ratio[i] * capacity;

                totalProfit += addedProfit;

                System.out.println("\nStep " + (i + 1));
                System.out.println("Partially Selected Item: " + (i + 1));
                System.out.println("Fraction Taken: " + fraction);
                System.out.println("Weight Taken: " + capacity);
                System.out.println("Profit Added: " + addedProfit);

                capacity = 0;

                System.out.println("Remaining Capacity: " + capacity);
                System.out.println("Total Profit: " + totalProfit);

                break;
            }
        }

        System.out.println("\nMaximum Profit = " + totalProfit);

        sc.close();
    }
}

/*
Time Complexity: O(n^2)
Space Complexity: O(n)
*/
