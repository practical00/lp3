# PR5: K-Means and Hierarchical Clustering

# Step 1: Import Libraries
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, AgglomerativeClustering
from scipy.cluster.hierarchy import dendrogram, linkage

# Step 2: Load Dataset
data = pd.read_csv("sales_data_sample.csv", encoding="latin1")

print("First 5 Rows of Dataset:")
print(data.head())

# Step 3: Select Numerical Features
X = data[['SALES', 'QUANTITYORDERED', 'PRICEEACH', 'MSRP']]

# Handle Missing Values
X = X.fillna(X.median())

# Step 4: Scale the Data
sc = StandardScaler()
X_scaled = sc.fit_transform(X)

# Step 5: Find Optimal Number of Clusters
wcss = []

for i in range(1, 11):
    model = KMeans(n_clusters=i, random_state=42, n_init=10)
    model.fit(X_scaled)
    wcss.append(model.inertia_)

# Step 6: Plot Elbow Graph
plt.plot(range(1, 11), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.show()

# Step 7: Apply K-Means Clustering
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
data['KMeans_Cluster'] = kmeans.fit_predict(X_scaled)

# Display K-Means Result
print("\nK-Means Clustering Result:")
print(data[['SALES', 'QUANTITYORDERED',
            'KMeans_Cluster']].head())

print("\nK-Means Cluster Count:")
print(data['KMeans_Cluster'].value_counts())

# Step 8: Plot K-Means Graph
plt.scatter(
    X_scaled[:, 0],
    X_scaled[:, 1],
    c=data['KMeans_Cluster'],
    cmap='viridis'
)

plt.title("K-Means Clustering")
plt.xlabel("Sales (Scaled)")
plt.ylabel("Quantity Ordered (Scaled)")
plt.show()

# Step 9: Apply Hierarchical Clustering
hc = AgglomerativeClustering(n_clusters=3)
data['Hierarchical_Cluster'] = hc.fit_predict(X_scaled)

# Display Hierarchical Result
print("\nHierarchical Clustering Result:")
print(data[['SALES', 'QUANTITYORDERED',
            'Hierarchical_Cluster']].head())

print("\nHierarchical Cluster Count:")
print(data['Hierarchical_Cluster'].value_counts())

# Step 10: Create Dendrogram
Z = linkage(X_scaled, method='ward')

plt.figure(figsize=(10, 5))
dendrogram(Z, truncate_mode='lastp', p=30)

plt.title("Hierarchical Clustering Dendrogram")
plt.xlabel("Data Points")
plt.ylabel("Distance")
plt.show()

# Step 11: Final Result
print("\nK-Means and Hierarchical Clustering Completed Successfully.")






